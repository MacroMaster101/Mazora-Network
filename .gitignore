# Dependencies
node_modules
.pnp
.pnp.js

# Next.js build output
.next
.next-dev
/out
/build

# Production / misc build
/coverage

# Environment variables (never commit real secrets — .env.example is the template)
#
# Ignore every .env variant and re-admit only the template. The previous list
# enumerated .env and the *.local files, which left .env.production,
# .env.development, .env.test and .env.staging fully trackable — the exact
# filenames someone reaches for when copying real credentials out of Vercel.
# Deny-by-default is the only version of this rule that stays correct as new
# variants appear.
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Deployment
.vercel

# Certificates / keys
*.pem

# Editor / IDE
.vscode
.idea
*.swp
*.swo
*~
*.bak
*.tmp
*.temp
*.orig
*.rej

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Local project docs (superpowers scratch)
/docs/superpowers
/.superpowers

# Local AI assistant workspaces and scratch state
/.codex
/.agents
/.agent
/.claude
/.cursor
/.aider
/.continue
