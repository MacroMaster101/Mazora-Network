# ---------------------------------------------------------------------------
# Mazora Network environment
# Everything is optional: with no vars set, the site runs on typed demo data.
# ---------------------------------------------------------------------------

# Public site URL (used for canonical URLs, sitemap, OpenGraph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Bedrock server port shown on Play and Status pages.
NEXT_PUBLIC_BEDROCK_PORT=8876

# Supabase Postgres connection string (Project Settings → Database → Connection string).
# Use the connection pooler URL for serverless/Next.js, e.g.
#   postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Leave empty to run entirely on in-memory demo data.
DATABASE_URL=

# Optional live Minecraft status API override (returns JSON).
# When empty, the site checks mc.mazora.us through api.mcsrvstat.us.
MINECRAFT_STATUS_API_URL=

# Shared secret the Minecraft plugin uses to POST account-link confirmations.
MINECRAFT_PLUGIN_SECRET=

# Discord invite override (public). When empty, the official Mazora invite is used.
NEXT_PUBLIC_DISCORD_INVITE_URL=

# --- Discord store ordering ---
# Private webhook that receives manual order requests. Create it in a
# staff-only channel: channel settings → Integrations → Webhooks → New
# Webhook → Copy URL. Orders cannot be submitted while this is empty.
# Treat it like a password and never prefix it with NEXT_PUBLIC_.
DISCORD_STORE_WEBHOOK_URL=
# Optional staff role to @mention on new orders. Enable Developer Mode in
# Discord, right-click the role → Copy Role ID. The role must allow mentions.
DISCORD_STORE_STAFF_ROLE_ID=

# --- Discord bot (optional upgrade: Confirm/Reject buttons + player DMs) ---
# When all three are set, order messages are posted by the bot with staff
# action buttons, and button decisions DM the player automatically.
# 1) Developer Portal → your application → Bot → Reset Token.
#    Invite the bot to the server with permission to send messages in the
#    orders channel.
DISCORD_BOT_TOKEN=
# 2) Developer Portal → General Information → Public Key (hex string). Used to
#    verify that button clicks really come from Discord.
DISCORD_APP_PUBLIC_KEY=
# 3) Right-click the orders channel → Copy Channel ID.
DISCORD_ORDERS_CHANNEL_ID=
# Finally set General Information → Interactions Endpoint URL to
#   https://<your-domain>/api/discord/interactions
# (the site must be deployed and reachable when you save it — Discord sends a
# verification ping). Button clicks do not reach localhost dev servers.

# --- Supabase Auth (required for production accounts and social login) ---
# The "Connect Discord" button on the order form uses Discord login, so the
# Discord provider must be enabled in Supabase Authentication → Providers
# (with a Discord application's Client ID/Secret from the Developer Portal).
NEXT_PUBLIC_SUPABASE_URL=
# Preferred key format for new Supabase projects.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Backward-compatible legacy key. Leave empty when using the publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local preview only. Never enable demo auth in production.
AUTH_DEMO_MODE=

# Production launch gate. Keep on while unfinished routes should show the
# polished launch-status page. Set to off to restore every implementation.
MAZORA_LAUNCH_MODE=on
