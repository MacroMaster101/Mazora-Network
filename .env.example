# ---------------------------------------------------------------------------
# Mazora Network environment
# Everything is optional: with no vars set, the site runs on typed demo data.
# ---------------------------------------------------------------------------

# Public site URL (used for canonical URLs, sitemap, OpenGraph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Bedrock server port shown on Play and Status pages.
NEXT_PUBLIC_BEDROCK_PORT=8876

# Supabase Postgres connection string (Project Settings → Database → Connection string).
# Use the connection pooler URL for serverless/Next.js, e.g.
#   postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Leave empty to run entirely on in-memory demo data.
DATABASE_URL=

# Optional live Minecraft status API override (returns JSON).
# When empty, the site checks mc.mazora.us through api.mcsrvstat.us.
MINECRAFT_STATUS_API_URL=

# Shared secret the Minecraft plugin uses to POST account-link confirmations.
MINECRAFT_PLUGIN_SECRET=

# Discord invite override (public). When empty, the official Mazora invite is used.
NEXT_PUBLIC_DISCORD_INVITE_URL=

# --- Supabase Auth (required for production accounts and social login) ---
NEXT_PUBLIC_SUPABASE_URL=
# Preferred key format for new Supabase projects.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Backward-compatible legacy key. Leave empty when using the publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local preview only. Never enable demo auth in production.
AUTH_DEMO_MODE=

# Production launch gate. Keep on while unfinished routes should show the
# polished launch-status page. Set to off to restore every implementation.
MAZORA_LAUNCH_MODE=on
