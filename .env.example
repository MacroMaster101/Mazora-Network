# Copy this to .env.bot (not .env) and fill it in.
#
# The repo holds two projects on different branches and they disagree about
# NEXT_PUBLIC_SITE_URL: the website dev server wants localhost, the bot probes
# the URL to decide whether the site is Live and needs production. A dedicated
# file keeps local bot runs matching Render without disturbing website dev.
#
#   npm run bot:presence        reads .env.bot
#   npm start                   reads the real environment (Render)

# Required: Discord Developer Portal -> Bot -> Reset Token.
DISCORD_BOT_TOKEN=

# The bot probes this to decide whether the site is Live.
# Defaults to https://mazora.us when left blank.
NEXT_PUBLIC_SITE_URL=

# Optional. Auto-detected at startup from the guild the bot is in;
# only needed if the bot ever joins more than one guild.
DISCORD_GUILD_ID=

# Optional. Set to true ONLY after enabling the Presence Intent under
# Developer Portal -> Bot -> Privileged Gateway Intents. With it on, both counts
# come off the gateway and the REST API is never called after startup. Turning
# it on without enabling it there closes the gateway with 4014.
DISCORD_PRESENCE_INTENT=false

# Optional timing. Minimums enforced in code: 30s for the data refresh, and 5s
# for the rotation (Discord allows 5 presence updates per 20s, so 4s is the
# hard limit and 5s leaves headroom).
DISCORD_PRESENCE_REFRESH_MS=60000
DISCORD_PRESENCE_ROTATE_MS=5000

# Render provides PORT automatically. Local default: 10000.
PORT=
