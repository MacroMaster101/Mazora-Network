# ---------------------------------------------------------------------------
# Mazora Network environment
#
# Copy to .env (or .env.local) and fill in what you need. Never commit either.
#
# Nothing here is required to boot: the site starts with no variables set. It
# will simply have no content — pages render empty states rather than inventing
# data — and anything needing Supabase or Discord stays switched off. Each
# section below says what turns on when you fill it in.
# ---------------------------------------------------------------------------


# === Site ==================================================================

# Canonical public URL. Used for OpenGraph, the sitemap, and every OAuth and
# Discord redirect, so it must match the deployed origin exactly in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Bedrock port shown on the Play and Status pages.
NEXT_PUBLIC_BEDROCK_PORT=8876

# Public Discord invite. When empty, the official Mazora invite is used.
# Also shown to buyers who have not joined the server yet at checkout.
NEXT_PUBLIC_DISCORD_INVITE_URL=


# === Database ==============================================================

# Supabase Postgres connection string
# (Project Settings → Database → Connection string).
# Use the connection pooler URL for serverless/Next.js, e.g.
#   postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Without it every content list is empty and orders cannot be recorded.
DATABASE_URL=


# === Supabase Auth =========================================================
# Required for real accounts, social login, and the whole admin area.
#
# The "Connect Discord" button uses Discord login, so enable the Discord
# provider in Supabase Authentication → Providers with a Discord application's
# Client ID/Secret, and add <NEXT_PUBLIC_SITE_URL>/auth/callback to the
# allowed redirect URLs.

NEXT_PUBLIC_SUPABASE_URL=
# Preferred key format for new Supabase projects.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Backward-compatible legacy key. Leave empty when using the publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Required for the Users and Staff boards, invitations and account
# deletion, because roles live in app_metadata which only this key may write.
# Never expose it publicly or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=


# === Minecraft =============================================================

# Optional live status API override (returns JSON).
# When empty, the site checks mc.mazora.us through api.mcsrvstat.us.
MINECRAFT_STATUS_API_URL=

# Shared secret the Minecraft plugin uses to POST account-link confirmations.
MINECRAFT_PLUGIN_SECRET=


# === Discord: bot ==========================================================
# Shared by store orders and the news importer. Without a token the store
# falls back to the plain webhook below (no buttons, no tickets, no DMs).

# Developer Portal → your application → Bot → Reset Token.
DISCORD_BOT_TOKEN=

# Developer Portal → General Information → Public Key (hex).
# Verifies that button clicks genuinely came from Discord.
DISCORD_APP_PUBLIC_KEY=

# Your server ID (right-click the server → Copy Server ID, Developer Mode on).
# Needed to check a buyer has joined before checkout and to create their ticket,
# and to link imported news back to the original message.
DISCORD_GUILD_ID=

# After deploying, set Developer Portal → General Information →
# Interactions Endpoint URL to:
#   https://<your-domain>/api/discord/interactions
# Discord sends a verification ping when you save it, so the site must already
# be live. Button clicks never reach a localhost dev server.


# === Discord: store orders =================================================

# Private webhook that receives manual order requests. Create it in a staff-only
# channel: channel settings → Integrations → Webhooks → New Webhook → Copy URL.
# Used only as a fallback when the bot is unavailable. Treat it like a password.
DISCORD_STORE_WEBHOOK_URL=

# Roles permitted to press Confirm, Reject, Close, Reopen and Announce, and to
# read every order ticket. Order actions are refused entirely while this is
# unset, so a valid Discord signature alone can never action an order.
#
# Accepts one id, or several separated by commas:
#   DISCORD_STORE_STAFF_ROLE_ID=<staff>,<management>,<owner>
# Only the FIRST role is @mentioned on a new order — the rest gain permission
# without being pinged every time. Administrator is not a substitute: on most
# servers several bot roles carry it.
DISCORD_STORE_STAFF_ROLE_ID=

# Staff channel the bot posts order requests into (right-click → Copy Channel ID).
DISCORD_ORDERS_CHANNEL_ID=


# === Discord: order tickets ================================================
# Confirming an order opens a private channel shared by the buyer and staff.

# Private category the ticket channels are created in.
# Needs DISCORD_GUILD_ID and DISCORD_STORE_STAFF_ROLE_ID above, and the bot role
# must hold View Channels + Manage Channels + Send Messages + Read Message
# History on that category. Without Manage Channels the confirm still succeeds
# but no channel is created. Leave empty to only DM the buyer.
DISCORD_STORE_TICKETS_CATEGORY_ID=

# Staff channel receiving a transcript each time a ticket is closed: a summary
# embed plus the whole conversation as a .txt attachment. The ticket channel is
# archived rather than deleted, so this is a convenience record, not the only
# copy. Leave empty to skip logging.
DISCORD_TICKET_LOGS_CHANNEL_ID=

# Public channel announcing completed purchases. Announcing is its own button,
# separate from closing: a ticket can end without a sale, and posting
# "X bought Y" for someone who never paid is worse than staying quiet.
#
# The banner artwork ships with the repo (public/images/mazora-purchase.webp)
# and is served from NEXT_PUBLIC_SITE_URL, so there is nothing else to set.
DISCORD_BUYERS_CHANNEL_ID=


# === Discord: news sync ====================================================

# Channel staff post announcements in. Imported into site news for review.
DISCORD_ANNOUNCEMENTS_CHANNEL_ID=

# Shared secret for the scheduled announcement sync (minimum 16 characters).
CRON_SECRET=


# === Operations ============================================================

# Launch gate. Keep on while unfinished routes should show the launch-status
# page. Set to off to restore every implementation.
MAZORA_LAUNCH_MODE=on

# Local preview only — bypasses Supabase with a fake session.
# Never enable in production.
AUTH_DEMO_MODE=
