# Required: Discord Developer Portal -> Bot -> Reset Token.
DISCORD_BOT_TOKEN=

# Live sources displayed by the rotating bot presence.
NEXT_PUBLIC_SITE_URL=https://mazora.us
NEXT_PUBLIC_DISCORD_INVITE_URL=

# Optional. Auto-detected at startup from the guild the bot is in;
# only needed if the bot ever joins more than one guild.
DISCORD_GUILD_ID=

# Optional timing. Code enforces minimums of 30s and 15s respectively.
DISCORD_PRESENCE_REFRESH_MS=60000
DISCORD_PRESENCE_ROTATE_MS=20000

# Render provides PORT automatically. Local default: 10000.
PORT=
