{
  "regions": ["sin1"],
  "installCommand": "env -u npm_config_cache_dir -u NPM_CONFIG_CACHE_DIR npm install",
  "buildCommand": "env -u npm_config_cache_dir -u NPM_CONFIG_CACHE_DIR npm run build",
  "crons": [
    {
      "path": "/api/cron/discord-news",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/cleanup-unconfirmed",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/cleanup-notifications",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/security-alerts",
      "schedule": "45 3 * * *"
    },
    {
      "path": "/api/cron/cleanup-audit-logs",
      "schedule": "0 4 * * 0"
    }
  ],
  "functions": {
    "src/app/**": {
      "maxDuration": 30
    }
  }
}
