{
  "name": "mazora-discord-presence",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "tsx scripts/discord-presence.ts",
    "bot:presence": "tsx --env-file=.env scripts/discord-presence.ts",
    "bot:presence:once": "tsx --env-file=.env scripts/discord-presence.ts --once",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
