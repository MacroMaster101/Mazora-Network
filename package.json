{
  "name": "mazora-network",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:apply": "tsx --env-file=.env scripts/apply-sql.ts",
    "db:seed:store": "tsx --env-file=.env scripts/seed-store.ts",
    "db:seed:rules": "tsx --env-file=.env scripts/seed-rules.ts",
    "role:set": "tsx --env-file=.env scripts/set-role.ts",
    "db:rehost:news-images": "tsx --env-file=.env scripts/rehost-news-images.ts",
    "discord:commands": "tsx --env-file=.env scripts/register-discord-commands.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.468.0",
    "next": "^15.5.20",
    "postgres": "^3.4.9",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.20",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.25"
    },
    "sharp": "^0.35.3",
    "esbuild": "^0.25.0"
  },
  "allowScripts": {
    "esbuild": true,
    "unrs-resolver": true,
    "sharp": true
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver",
      "sharp"
    ]
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 121",
    "safari >= 16.4",
    "ios_saf >= 16.4",
    "not dead"
  ]
}
